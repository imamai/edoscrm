# EDOS CRM — environment
# Copy to .env.local and fill in. .env.local is gitignored.

# The Supabase project shared with edos-poa, legacy edospoa-posv1, edoshatch360
# and edospmis. See ARCHITECTURE.md §2 for what that sharing does and doesn't
# mean for tenant isolation.
NEXT_PUBLIC_SUPABASE_URL=https://cnlyuwslpcgosgwdmzav.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses every row-level security policy in the project —
# every other product's tables included. Never prefix this NEXT_PUBLIC_, never
# import it into a Client Component. Set it here AND in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Outbound email — EDOS CRM sends its own via Resend rather than relying on
# the project's shared SMTP settings (see ARCHITECTURE.md §2).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@edoscentre.co.ke

# edos.ai (ARCHITECTURE.md §11). Server-only — see src/lib/ai/client.ts.
# Without this set, edos.ai's "Summarize case" button returns a clear
# "not configured yet" error instead of failing silently.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Authorises the scheduled pass at /api/cron (ARCHITECTURE.md §15): SLA
# reminders, escalation of overdue cases, batch re-checks, retention purging
# and the weekly/monthly reports. Vercel Cron sends this as
# `Authorization: Bearer $CRON_SECRET`.
#
# Required. With no value set the endpoint refuses to run rather than
# defaulting to open — it emails entire workspaces and deletes personal data,
# so failing closed is the only safe default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Set the same value here AND in Vercel.
CRON_SECRET=

# Optional. Authorises the email-to-case webhook at /api/v1/inbound-email,
# which a mail provider (Resend, Postmark, SendGrid, Mailgun) posts to when a
# message arrives at the complaints address. Messages land in /inbox for
# somebody to turn into a case — nothing becomes a complaint automatically.
# Leave blank to keep the endpoint switched off.
INBOUND_EMAIL_SECRET=
